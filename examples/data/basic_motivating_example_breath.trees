#NEXUS

Begin taxa;
	Dimensions ntax=3;
		Taxlabels
			A
			B
			C
			;
End;
Begin trees;
	Translate
		   1 A,
		   2 B,
		   3 C,
;
tree t1 = (1[&blockcount.t:bla=-1]:1.0,(2[&blockcount.t:bla=-1]:1.0,3[&blockcount.t:bla=0]:1.0)[&blockcount.t:bla=0]:1.0)[&blockcount.t:bla=-1]:1.0;
tree t2 = (1[&blockcount.t:bla=-1]:1.0,(2[&blockcount.t:bla=0]:1.0,3[&blockcount.t:bla=-1]:1.0)[&blockcount.t:bla=0]:1.0)[&blockcount.t:bla=-1]:1.0;
tree t3 = (1[&blockcount.t:bla=0]:1.0,(2[&blockcount.t:bla=0]:1.0,3[&blockcount.t:bla=-1]:1.0)[&blockcount.t:bla=-1]:1.0)[&blockcount.t:bla=-1]:1.0;
tree t4 = (1[&blockcount.t:bla=0]:1.0,(2[&blockcount.t:bla=0]:1.0,3[&blockcount.t:bla=0]:1.0)[&blockcount.t:bla=-1]:1.0)[&blockcount.t:bla=-1]:1.0;
End;